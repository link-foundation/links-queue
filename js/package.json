{
  "name": "links-queue",
  "version": "0.15.1",
  "description": "Links Queue - a universal queue system using links (JavaScript implementation)",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "links-queue": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": {
      "import": "./src/server/index.js"
    },
    "./client": {
      "import": "./src/client/index.js"
    },
    "./express": {
      "types": "./packages/express/src/index.d.ts",
      "import": "./packages/express/src/index.js"
    },
    "./fastify": {
      "types": "./packages/fastify/src/index.d.ts",
      "import": "./packages/fastify/src/index.js"
    },
    "./hono": {
      "types": "./packages/hono/src/index.d.ts",
      "import": "./packages/hono/src/index.js"
    },
    "./nestjs": {
      "types": "./packages/nestjs/src/index.d.ts",
      "import": "./packages/nestjs/src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "bench": "node tests/memory.benchmark.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "prepare": "cd .. && husky js/.husky || true",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "npm publish --access public --provenance",
    "changeset:status": "changeset status --since=origin/main",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "keywords": [
    "links-queue",
    "queue",
    "links",
    "javascript",
    "typescript",
    "tcp-server",
    "message-queue"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/links-queue",
    "directory": "js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "dependencies": {
    "links-notation": "^0.13.0",
    "fastify-plugin": "^5.0.0"
  },
  "files": [
    "src",
    "packages/express/src",
    "packages/fastify/src",
    "packages/hono/src",
    "packages/nestjs/src",
    "packages/*/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  }
}
